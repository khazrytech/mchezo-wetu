# Mchezo Wetu - environment variables (nakili kwenda .env, usiweke .env kwenye git)

# === Supabase ===
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# === Admin ===
# Barua pepe ya admin mkuu (inaweza kubadilishwa bila kubadilisha msimbo).
ADMIN_EMAIL=hackertrick1997@gmail.com

# === Brevo (OTP na arifa kwa barua pepe) ===
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
BREVO_SENDER_NAME=Mchezo Wetu

# === Beem Africa (vikumbusho vya SMS) ===
BEEM_API_KEY=YOUR_BEEM_API_KEY
BEEM_SECRET_KEY=YOUR_BEEM_SECRET_KEY
BEEM_SOURCE_ADDR=YOUR_APPROVED_SENDER_ID
REMINDER_CRON_SECRET=YOUR_LONG_RANDOM_CRON_SECRET

# === SonicPesa (malipo ya mtandao) ===
SONICPESA_API_KEY=YOUR_SONICPESA_API_KEY
SONICPESA_API_SECRET=YOUR_SONICPESA_WEBHOOK_SECRET

# === Server ===
PUBLIC_SITE_URL=https://mchezo-wetu.onrender.com
PORT=3000
NODE_ENV=production
